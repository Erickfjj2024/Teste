+                        );
+                        return;
+                    }
+                    let rotation = (yaw.is_some() || pitch.is_some())
+                        .then(|| [yaw.unwrap_or(self.yaw), pitch.unwrap_or(self.pitch)]);
+                    self.teleport_to_in_level(Target::Player, pos, rotation);
+                }
+                Output::TakeXp { name, player, points } => {
+                    if !self.is_own_player(&player) {
+                        log::warn!("Horizon: mod {name} can only charge the window's own player");
+                        return;
+                    }
+                    let points = i32::try_from(points).unwrap_or(i32::MAX);
+                    self.change_experience(true, false, -points);
+                }
+                Output::PlaySound {
+                    dimension,
+                    sound,
+                    pos,
+                    volume,
+                    pitch,
+                    ..
+                } => {
+                    if dimension == self.dim.id() {
+                        self.audio.play(&sound, Some(pos), volume, pitch);
+                    }
+                }
                 _ => {}
             }
         }
