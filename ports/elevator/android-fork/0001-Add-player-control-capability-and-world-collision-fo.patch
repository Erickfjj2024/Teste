+        /// capability `player-control` reaches so far.
+        fn is_own_player(&self, id: &str) -> bool {
+            self.options.execution_role.is_client()
+                && self.remote.is_none()
+                && self.player.is_some()
+                && id == uuid_string(self.player_uuid())
+        }
