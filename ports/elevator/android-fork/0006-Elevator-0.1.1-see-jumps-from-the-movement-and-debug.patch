 .../examples/elevator/src/lib.rs              | 119 +++++++++++++++---
 .../examples/elevator/tests/config.toml       |   7 ++
 .../elevator/tests/jump_off_the_ground.toml   |  20 +++
 .../tests/jump_without_the_count.toml         |  22 ++++
 .../elevator/tests/no_jump_in_the_air.toml    |  21 ++++
 6 files changed, 170 insertions(+), 21 deletions(-)
 create mode 100644 crates/horizon-mod-sdk/examples/elevator/tests/jump_off_the_ground.toml
