diff --git a/crates/horizon-mod-sdk/examples/elevator/tests/jump_off_the_ground.toml b/crates/horizon-mod-sdk/examples/elevator/tests/jump_off_the_ground.toml
new file mode 100644
index 0000000..777242b
--- /dev/null
+++ b/crates/horizon-mod-sdk/examples/elevator/tests/jump_off_the_ground.toml
@@ -0,0 +1,20 @@
+# Leaving the ground going up, with the count still at 0, is a jump too, even when the feet are
+# not on the elevator itself: here a carpet lies on it (a carpet does not suffocate).
+
+[[step]]
+join = "Alex"
+motion = { jumps = 0, on-ground = true }
+blocks = [
+    { x = 0, y = 63, z = 0, state = "elevatorid:elevator_white[directional=false,facing=north,show_arrow=true]" },
+    { x = 0, y = 64, z = 0, state = "minecraft:white_carpet" },
+    { x = 0, y = 69, z = 0, state = "elevatorid:elevator_red[directional=false,facing=north,show_arrow=true]" },
+]
+player = { y = 64.0625 }
+ticks = 1
+
+# The ground flag goes off as they rise by a jump's height.
+[[step]]
+player = { y = 64.4825 }
+motion = { on-ground = false }
+ticks = 1
+expect.teleports = ["Alex: minecraft:overworld 0.5 70 0.5 ~ ~"]
diff --git a/crates/horizon-mod-sdk/examples/elevator/tests/jump_without_the_count.toml b/crates/horizon-mod-sdk/examples/elevator/tests/jump_without_the_count.toml
new file mode 100644
index 0000000..68556f6
--- /dev/null
+++ b/crates/horizon-mod-sdk/examples/elevator/tests/jump_without_the_count.toml
@@ -0,0 +1,22 @@
+# A jump is also seen from the player's own movement, for a world whose jump count does not move:
+# the count stays 0 here, and the player rises by a jump's height from the top of an elevator.
+
+[[step]]
+join = "Alex"
+motion = { jumps = 0, on-ground = true }
+blocks = [
+    { x = 0, y = 63, z = 0, state = "elevatorid:elevator_white[directional=false,facing=north,show_arrow=true]" },
+    { x = 0, y = 68, z = 0, state = "elevatorid:elevator_red[directional=false,facing=north,show_arrow=true]" },
+]
+ticks = 1
+
+# Rising 0.42 from the elevator, with the ground flag still set: a jump.
+[[step]]
+player = { y = 64.42 }
+ticks = 1
+expect.teleports = ["Alex: minecraft:overworld 0.5 69 0.5 ~ ~"]
+
+# The ride moved them up by 4.58: not a jump, and the cooldown holds anyway.
+[[step]]
+ticks = 4
+expect.teleports = []
diff --git a/crates/horizon-mod-sdk/examples/elevator/tests/no_jump_in_the_air.toml b/crates/horizon-mod-sdk/examples/elevator/tests/no_jump_in_the_air.toml
