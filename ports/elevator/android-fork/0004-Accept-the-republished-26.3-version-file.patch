+      "5df1795e16eea19d75b923d66ecca9ce183353c5",
+      "80608ff6753705b6a82e2cb86a5937d4d233abd4"
     ],
     "accepted_manifest_note": "Other 26.3 version JSONs Mojang republished: only assetIndex differs (non-English translations), jars and libraries are identical. A launcher may still hold any of them.",
     "accepted_asset_index_sha1": [
