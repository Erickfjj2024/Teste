 research-lock.json | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/research-lock.json b/research-lock.json
index 719c266..32f0bc8 100644
--- a/research-lock.json
+++ b/research-lock.json
@@ -6,14 +6,16 @@
       "4fe1aa1ef8da1cb95c5bad1fb98890ca56dd8ca3",
       "702fe59163c6ee6578607daa85811d9bc9c7cc40",
       "61fff1316bd50312624a858bbb5eb18fa45208ed",
