From f5057d0c7bb31e4589a1987c61977e09032f5ffa Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 21:02:40 +0000
Subject: [PATCH] Elevator 0.1.3: watch off by default; /elevator debug finds
 the player by name

---
 crates/horizon-mod-sdk/examples/elevator/horizon-mod.toml | 2 +-
 crates/horizon-mod-sdk/examples/elevator/src/lib.rs       | 8 ++++++--
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/crates/horizon-mod-sdk/examples/elevator/horizon-mod.toml b/crates/horizon-mod-sdk/examples/elevator/horizon-mod.toml
index 812a5d7..bcacb09 100644
--- a/crates/horizon-mod-sdk/examples/elevator/horizon-mod.toml
+++ b/crates/horizon-mod-sdk/examples/elevator/horizon-mod.toml
@@ -1,6 +1,6 @@
 id = "elevator"
 name = "Elevator"
-version = "0.1.2"
+version = "0.1.3"
 description = "Jump on an elevator block to go up to the next one above, sneak to go down. Rust port of ElevatorMod (VsnGamer, MIT). Needs the Elevator blocks mod (elevatorid)."
 authors = ["VsnGamer (ElevatorMod, MIT)", "Rust port"]
 api = "0.3"
diff --git a/crates/horizon-mod-sdk/examples/elevator/src/lib.rs b/crates/horizon-mod-sdk/examples/elevator/src/lib.rs
index 4b8c09c..7da219d 100644
--- a/crates/horizon-mod-sdk/examples/elevator/src/lib.rs
+++ b/crates/horizon-mod-sdk/examples/elevator/src/lib.rs
@@ -57,8 +57,8 @@ const JUMP_RISE: std::ops::RangeInclusive<f64> = 0.3..=3.0;
 const RIDE_COOLDOWN: u8 = 3;
 
 /// Whether a new mod starts telling players what it sees of their movement (`/elevator watch`).
-/// On while the jump is being tracked down.
-const WATCH_DEFAULT: bool = true;
+/// Off by default; it is for tracking down a jump that is not seen.
+const WATCH_DEFAULT: bool = false;
 
 struct Elevators {
     /// Tells each player what the mod sees of their movement, when it changes.
@@ -269,6 +269,10 @@ impl Elevators {
 
     /// `/elevator debug`: what the mod sees of the player who typed it.
     fn debug(&self, p: &Player) -> String {
+        // The id a typed command carries is not always the one `players::online` lists (it
+        // differed for the owner of a single-player world), so find the player by name.
+        let listed = players::online().into_iter().find(|q| q.name == p.name);
+        let p = listed.as_ref().unwrap_or(p);
         let Some(m) = player_control::get_motion(&p.id) else {
             return "No motion is reported for you".into();
         };
-- 
2.43.0

