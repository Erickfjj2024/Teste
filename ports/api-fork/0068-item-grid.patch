+    let Some(at) = SCREEN_AT.lock().ok().and_then(|s| *s) else { return Vec::new() };
+    MENU_GRID.lock().ok().and_then(|m| m.as_ref()?.get(&at).cloned()).unwrap_or_default()
+}
