+[[step]]
+# block-break-start: breaking a block with the mod's drill cancels the normal break and breaks a column of 3 instead.
+blocks = [{ x = 5, y = 66, z = 5, state = "minecraft:stone" }, { x = 5, y = 65, z = 5, state = "minecraft:stone" }, { x = 5, y = 64, z = 5, state = "minecraft:stone" }]
