@@ -0,0 +1,46 @@
+# generator - cable x3 - machine, with a second machine above the middle cable.
+
+[[step]]
+join = "Alex"
+blocks = [
+    { x = 0, y = 64, z = 0, state = "cabledemo:generator" },
+    { x = 1, y = 64, z = 0, state = "cabledemo:cable" },
+    { x = 2, y = 64, z = 0, state = "cabledemo:cable" },
+    { x = 3, y = 64, z = 0, state = "cabledemo:cable" },
+    { x = 4, y = 64, z = 0, state = "cabledemo:machine" },
+    { x = 2, y = 65, z = 0, state = "cabledemo:machine" },
+]
+ticks = 1
+# 10 made, shared evenly between the two machines.
+expect.block-energy = [
+    { x = 0, y = 64, z = 0, energy = 0 },
+    { x = 4, y = 64, z = 0, energy = 5 },
+    { x = 2, y = 65, z = 0, energy = 5 },
+]
+
+[[step]]
+ticks = 3
+expect.block-energy = [
+    { x = 4, y = 64, z = 0, energy = 20 },
+    { x = 2, y = 65, z = 0, energy = 20 },
+]
+
+[[step]]
+# Taking the middle cable away splits the network: the machine above has no cable.
+blocks = [{ x = 2, y = 64, z = 0, state = "minecraft:air" }]
+ticks = 1
+expect.block-energy = [
+    { x = 0, y = 64, z = 0, energy = 10 },
+    { x = 4, y = 64, z = 0, energy = 20 },
+    { x = 2, y = 65, z = 0, energy = 20 },
+]
+
+[[step]]
+# Put it back: the generator's 10 and the new 10 flow again, 30 at most.
+blocks = [{ x = 2, y = 64, z = 0, state = "cabledemo:cable" }]
+ticks = 1
+expect.block-energy = [
+    { x = 0, y = 64, z = 0, energy = 0 },
+    { x = 4, y = 64, z = 0, energy = 30 },
+    { x = 2, y = 65, z = 0, energy = 30 },
+]
