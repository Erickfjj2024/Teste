+            let guests: Vec<(u32, u128, bool, bool)> = self
+                .lan
+                .iter()
+                .flat_map(|h| &h.hub.guests)
+                .filter(|g| g.placed)
+                .map(|g| (g.conn, g.uuid, g.sneaking, g.mod_may_fly))
+                .collect();
+            for (conn, uuid, _, _) in guests {
+                if let Some(s) = self.for_player(Target::Guest(conn), |g| g.own_state()) {
