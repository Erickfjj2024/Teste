+        let bytes = encode_menu_text([-3, 64, 12], &texts);
+        assert_eq!(decode_menu_text(&bytes), Some(([-3, 64, 12], texts)));
+        assert_eq!(decode_menu_text(&bytes[..bytes.len() - 1]), None);
+        assert_eq!(decode_menu_text(&[0; 5]), None);
+    }
+}
