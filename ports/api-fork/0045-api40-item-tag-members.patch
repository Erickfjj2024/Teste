diff --git a/crates/horizon-mod-sdk/examples/crafting-probe/src/lib.rs b/crates/horizon-mod-sdk/examples/crafting-probe/src/lib.rs
index c0d238730..4296544e3 100644
--- a/crates/horizon-mod-sdk/examples/crafting-probe/src/lib.rs
+++ b/crates/horizon-mod-sdk/examples/crafting-probe/src/lib.rs
@@ -34,7 +34,10 @@ impl ServerMod for Probe {
         let other = recipe_types::crafting_matches("minecraft:torch", &grid);
         let size = recipe_types::item_max_stack_size("minecraft:stick").map_or("none".to_owned(), |n| n.to_string());
         let tags = recipe_types::item_tags("minecraft:oak_planks").join(",");
-        let _ = players::tell(&player.id, &format!("{text}; stick {matches}; torch {other}; size {size}; tags {tags}"));
+        // API 40: the items of a tag, in its order; a `#` in front is the same tag, an unknown tag has none.
+        let members = recipe_types::item_tag_members("#minecraft:planks").join(",");
+        let none = recipe_types::item_tag_members("c:nothing").len();
+        let _ = players::tell(&player.id, &format!("{text}; stick {matches}; torch {other}; size {size}; tags {tags}; planks {members}; nothing {none}"));
         true
     }
 }
diff --git a/crates/horizon-mod-sdk/examples/crafting-probe/tests/craft.toml b/crates/horizon-mod-sdk/examples/crafting-probe/tests/craft.toml
index 690b3b465..8e7d91f05 100644
--- a/crates/horizon-mod-sdk/examples/crafting-probe/tests/craft.toml
+++ b/crates/horizon-mod-sdk/examples/crafting-probe/tests/craft.toml
@@ -6,7 +6,7 @@ grid = ["", "minecraft:oak_planks*1", "", "", "minecraft:oak_planks*1", "", "",
 output = "minecraft:stick*4"
 
 [tags]
-"minecraft:planks" = ["minecraft:oak_planks"]
+"minecraft:planks" = ["minecraft:oak_planks", "minecraft:spruce_planks", "minecraft:birch_planks"]
 "c:planks" = ["minecraft:oak_planks"]
 
 [stack-sizes]
@@ -16,4 +16,4 @@ output = "minecraft:stick*4"
 join = "Alex"
 use-item = { stack = "craftprobe:probe*1" }
 expect.claimed = true
-expect.told = ["Alex: minecraft:stick makes minecraft:stick*4 keeps 0; stick true; torch false; size 64; tags c:planks,minecraft:planks"]
+expect.told = ["Alex: minecraft:stick makes minecraft:stick*4 keeps 0; stick true; torch false; size 64; tags c:planks,minecraft:planks; planks minecraft:oak_planks,minecraft:spruce_planks,minecraft:birch_planks; nothing 0"]
diff --git a/crates/horizon-mod-sdk/wit/horizon.wit b/crates/horizon-mod-sdk/wit/horizon.wit
index f32f8e269..cf7f796e7 100644
--- a/crates/horizon-mod-sdk/wit/horizon.wit
+++ b/crates/horizon-mod-sdk/wit/horizon.wit
@@ -1036,6 +1036,10 @@ interface recipe-types {
     /// the `#`), sorted; empty for an item in none or one the game does not
     /// know. The reverse of `ingredient-items` for a tag. API 30.
     item-tags: func(item: string) -> list<string>;
+    /// The items of the item tag `tag` (`c:ingots/iron`; a leading `#` is taken off) in the game's order (the tag files', nested tags in
+    /// place, first occurrence kept: what `TagKey` lists and Mekanism's Oredictionificator offers as a filter's results); empty for a tag
+    /// the game does not have. The reverse of `item-tags`. API 40.
+    item-tag-members: func(tag: string) -> list<string>;
 }
 
 /// Capability `net`, server mods only (manifest `api = "0.3"`, experimental):
diff --git a/crates/horizon-mods/src/api_level.rs b/crates/horizon-mods/src/api_level.rs
index 15f2d6beb..335d9af07 100644
--- a/crates/horizon-mods/src/api_level.rs
+++ b/crates/horizon-mods/src/api_level.rs
@@ -7,13 +7,13 @@
 //! version's level so the launcher can tell before it installs.
 
 /// The newest level this Horizon serves.
-pub const LEVEL: u32 = 39;
+pub const LEVEL: u32 = 40;
 
 /// Every function the game offers mods, as `interface.function`, with its
 /// level. Level 0 is the contract of Horizon 0.2.67 to 0.2.69. A new
 /// function takes the next level and raises [`LEVEL`] (the `api_reference`
 /// test fails until it is listed here).
-pub const FUNCTIONS: [(&str, u32); 110] = [
+pub const FUNCTIONS: [(&str, u32); 111] = [
     ("log.write", 0),
     ("game.get-player", 0),
     ("game.get-clock", 0),
@@ -104,6 +104,7 @@ pub const FUNCTIONS: [(&str, u32); 110] = [
     ("world.set-menu-text", 34),
     ("world.set-comparator-output", 38),
     ("world.break-blocks", 39),
+    ("recipe-types.item-tag-members", 40),
     ("world.block-hardness", 35),
     ("world.spawn-particles", 26),
     ("recipe-types.burn-time", 27),
diff --git a/crates/horizon-mods/src/runtime.rs b/crates/horizon-mods/src/runtime.rs
index c9bf6c607..4a5841816 100644
--- a/crates/horizon-mods/src/runtime.rs
+++ b/crates/horizon-mods/src/runtime.rs
@@ -3302,6 +3302,11 @@ impl recipe_types::Host for State {
         tags.sort();
         tags
     }
+    fn item_tag_members(&mut self, tag: String) -> Vec<String> {
+        let Ok(slot) = self.recipe_data.lock() else { return Vec::new() };
+        let Some(data) = slot.as_ref() else { return Vec::new() };
+        data.tags.get(tag.strip_prefix('#').unwrap_or(&tag)).cloned().unwrap_or_default()
+    }
     fn burn_time(&mut self, item: String) -> Option<u32> {
         let slot = self.recipe_data.lock().ok()?;
         slot.as_ref()?.burn_times.get(&item).copied().filter(|t| *t > 0)
