+/// A table with a `states` list at its top, which stays as text row by row (`J::Raw`): the rows of vanilla's
+/// 35,000 states are the bulk of the table, and the build copies them as they are.
+fn read_json_rows(path: &Path) -> Result<J> {
+    struct Lazy(J);
+    impl<'de> Deserialize<'de> for Lazy {
+        fn deserialize<D: de::Deserializer<'de>>(d: D) -> std::result::Result<Self, D::Error> {
+            struct V;
+            impl<'de> de::Visitor<'de> for V {
+                type Value = Lazy;
+                fn expecting(&self, f: &mut fmt::Formatter) -> fmt::Result {
+                    f.write_str("a JSON object")
+                }
+                fn visit_map<A: de::MapAccess<'de>>(
+                    self,
+                    mut a: A,
+                ) -> std::result::Result<Lazy, A::Error> {
+                    let mut out = Vec::new();
+                    while let Some(key) = a.next_key::<String>()? {
+                        let value = if key == "states" {
+                            let rows: Vec<Box<serde_json::value::RawValue>> = a.next_value()?;
+                            J::Arr(rows.into_iter().map(|r| J::Raw(Raw(r))).collect())
+                        } else {
+                            a.next_value::<J>()?
+                        };
+                        out.push((key, value));
+                    }
+                    Ok(Lazy(J::Obj(out)))
+                }
+            }
+            d.deserialize_map(V)
+        }
+    }
+    let bytes = fs::read(path)?;
+    let lazy: Lazy =
+        serde_json::from_slice(&bytes).map_err(|e| format!("{}: {e}", path.display()))?;
+    Ok(lazy.0)
