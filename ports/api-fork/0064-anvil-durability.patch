+        if !part.trim().starts_with(key) {
+            parts.push(part.trim().to_owned());
+        }
+    }
+    if damage > 0 {
+        parts.push(format!("{key}{damage}"));
+    }
+    if parts.is_empty() { String::new() } else { format!("{{{}}}", parts.join(",")) }
+}
