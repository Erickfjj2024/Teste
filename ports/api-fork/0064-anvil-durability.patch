index 000000000..a0317d0a0
--- /dev/null
+++ b/crates/horizon-mod-sdk/examples/anvil-probe/tests/anvil.toml
@@ -0,0 +1,36 @@
+# The world's items as the script has them: an iron sword wears out after 250 and iron ingots repair it.
+[max-damage]
+"minecraft:iron_sword" = 250
+
+[repairs]
+"minecraft:iron_sword" = ["minecraft:iron_ingot"]
+
+# What the anvil makes of a worn sword and two ingots, renamed "Edge".
+[[anvil]]
+left = 'minecraft:iron_sword*1{"minecraft:damage":200,"minecraft:enchantments":{"minecraft:sharpness":3}}'
+right = "minecraft:iron_ingot*2"
+name = "Edge"
+result = 'minecraft:iron_sword*1{"minecraft:damage":76,"minecraft:custom_name":"Edge"}'
+cost = 3
+material_cost = 2
+
+[[step]]
+join = "Alex"
+inventory = ['minecraft:iron_sword*1{"minecraft:damage":200,"minecraft:enchantments":{"minecraft:sharpness":3}}', "minecraft:iron_ingot*2"]
+
+[[step]]
+# The sword's wear and enchantment, the ingots repair it, the anvil's answer; then it is mended by 10.
+net = { channel = "anvilprobe:go", data = [69, 100, 103, 101] }
+expect.told = [
+    "Alex: wear 200/250; enchantments [minecraft:sharpness 3]; repairs true",
+    'Alex: anvil minecraft:iron_sword*1{"minecraft:damage":76,"minecraft:custom_name":"Edge"} for 3 levels, 2 used',
+]
+expect.player-items = ['set-slot Alex 0 minecraft:iron_sword*1{"minecraft:enchantments":{"minecraft:sharpness":3},"minecraft:damage":190}']
+
+[[step]]
+# A stick does not wear out, is not repaired by ingots, and makes nothing in an anvil (the script has no answer for it).
+inventory = ["minecraft:stick*1", "minecraft:iron_ingot*2"]
+
+[[step]]
+net = { channel = "anvilprobe:go" }
+expect.told = ["Alex: wear no wear; enchantments []; repairs false", "Alex: anvil nothing"]
