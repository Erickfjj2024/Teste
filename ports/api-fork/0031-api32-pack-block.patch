+                    Some(horizon_client_render::containers::BlockEntity::Mod(m)) => m.nbt.get(&Self::jname("captured")).is_some(),
+                    _ => return false,
+                };
+                if holds {
+                    return false;
+                }
+            }
+            if air {
                 return false;
             }
             let mut captured = Compound::default();
@@ -951,12 +968,21 @@ mod run {
