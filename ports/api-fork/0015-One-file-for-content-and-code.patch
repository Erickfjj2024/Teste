+/// Direção em que o jogador fica virado em elevadores direcionais.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Facing {
+    North,
+    South,
+    East,
+    West,
+}
+
+impl Facing {
+    /// Rotação horizontal (yaw) em graus, como `Direction.toYRot()`.
+    pub fn to_yaw(self) -> f32 {
+        match self {
+            Facing::South => 0.0,
+            Facing::West => 90.0,
+            Facing::North => 180.0,
+            Facing::East => 270.0,
+        }
+    }
+}
