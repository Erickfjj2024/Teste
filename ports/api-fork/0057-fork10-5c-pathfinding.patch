+    fn a_mod_entity_path_goes_round_a_wall_and_through_an_open_door_only() {
+        let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../.local/horizon-client").join(horizon_core::VANILLA_VERSION);
