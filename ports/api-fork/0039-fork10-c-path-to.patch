+        let mut stop = update(1);
+        stop.stop = true;
+        apply(&mut e, &k, &stop);
+        assert_eq!(e.goal, None);
+        apply(&mut e, &k, &u);
+        let mut tp = update(1);
+        tp.teleport = Some((9.0, 70.0, 9.0));
+        apply(&mut e, &k, &tp);
+        assert_eq!((e.goal, e.pos), (None, [9.0, 70.0, 9.0]));
