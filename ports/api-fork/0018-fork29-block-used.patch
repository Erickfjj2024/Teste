+    /// decides for the block's own use (FORK-29). The first mod that does not answer `default` decides.
+    pub fn block_used(
+        &mut self,
+        player: &ServerPlayer,
+        pos: [i32; 3],
+        sneaking: bool,
+        stack: Option<&ModItemStack>,
+    ) -> BlockUse {
+        let at = BlockPos { x: pos[0], y: pos[1], z: pos[2] };
+        for i in 0..self.entries.len() {
