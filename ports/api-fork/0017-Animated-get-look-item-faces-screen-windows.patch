+                                game.looks.push((id, (0.0, 0.0)));
+                                game.looks.len() - 1
+                            }
+                        };
+                        let look = &mut game.looks[at].1;
+                        look.0 = set.yaw.unwrap_or(look.0);
+                        look.1 = set.pitch.unwrap_or(look.1);
+                    }
+                }
                 None => set.apply(game.player.get_or_insert_with(default_player)),
             }
         }
