+        Widget::Button { x, y, w, h, id, alt_id, local, .. } if inside(at, *x, *y, *w, *h) => {
+            Some((*id, *alt_id, local.clone()))
+        }
+        _ => None,
+    })?;
+    let (id, alt_id, local) = hit;
+    if let Some(action) = local {
+        match action {
+            LocalAction::Open(window) => {
