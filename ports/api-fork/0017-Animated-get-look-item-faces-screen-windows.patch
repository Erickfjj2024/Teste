+
+fn worn_slot_mut(guest: &mut Guest, n: usize) -> Option<&mut Option<ItemStack>> {
+    if n < 4 { guest.armor.get_mut(n) } else if n == 4 { Some(&mut guest.offhand) } else { None }
+}
