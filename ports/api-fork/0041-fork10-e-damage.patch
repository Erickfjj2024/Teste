+    /// Takes `amount` of health from the mod entity `id`: whether it died of it.
+    pub(super) fn damage_mod_entity(&mut self, id: u32, amount: f32) -> bool {
+        let Some(e) = self.mod_entities.list.iter_mut().find(|e| e.id == id) else {
